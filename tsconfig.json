{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"moduleResolution": "Bundler",
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2021"
		],
		"types": [
			"node"
		],
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"vitest.config.ts"
	]
}
